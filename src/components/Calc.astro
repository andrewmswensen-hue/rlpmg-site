---
/**
 * Shared calculator shell. Renders a real <form> with labeled inputs and a results region.
 * With JavaScript disabled the form still shows its default values and the page's static worked example stands.
 * Each calculator page supplies its own <script> that reads data-calc inputs and writes into [data-calc-out].
 */
export interface Field {
  name: string;
  label: string;
  type?: 'number' | 'select';
  value?: number | string;
  min?: number;
  max?: number;
  step?: number;
  prefix?: string;
  suffix?: string;
  hint?: string;
  options?: { value: string; label: string }[];
}
interface Props {
  id: string;
  heading: string;
  fields: Field[];
  outputs: { name: string; label: string; hero?: boolean; hint?: string }[];
  note?: string;
}
const { id, heading, fields, outputs, note } = Astro.props;
---

<section aria-labelledby={`${id}-heading`} class="not-prose my-10 border border-gray" data-calc={id}>
  <h2 id={`${id}-heading`} class="border-b border-gray bg-navy-800 px-5 py-3 text-lg font-semibold text-white">{heading}</h2>
  <div class="grid gap-0 md:grid-cols-[1.1fr_0.9fr]">
    <form class="p-5" data-calc-form onsubmit="return false">
      <div class="grid gap-4 sm:grid-cols-2">
        {fields.map((f) => (
          <div class={f.type === 'select' ? 'sm:col-span-2' : ''}>
            <label class="block text-sm font-medium text-navy-800">
              {f.label}
              {f.type === 'select' ? (
                <select name={f.name} class="mt-1 block w-full border border-gray bg-paper px-3 py-2">
                  {f.options?.map((o) => <option value={o.value} selected={o.value === String(f.value)}>{o.label}</option>)}
                </select>
              ) : (
                <span class="mt-1 flex items-center border border-gray bg-paper focus-within:border-navy-800">
                  {f.prefix && <span class="px-2 text-navy-600" aria-hidden="true">{f.prefix}</span>}
                  <input
                    type="number"
                    name={f.name}
                    value={f.value}
                    min={f.min}
                    max={f.max}
                    step={f.step ?? 1}
                    inputmode="decimal"
                    class="w-full bg-transparent px-2 py-2 tabular-nums outline-none"
                  />
                  {f.suffix && <span class="px-2 text-navy-600" aria-hidden="true">{f.suffix}</span>}
                </span>
              )}
            </label>
            {f.hint && <p class="mt-1 text-xs text-navy-600">{f.hint}</p>}
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-navy-600">Results update as you type. Nothing is sent anywhere and no email is required.</p>
    </form>
    <div class="border-t border-gray bg-offwhite p-5 md:border-l md:border-t-0">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-navy-800">Result</h3>
      <dl class="mt-3" aria-live="polite">
        {outputs.map((o) => (
          <div class={o.hero ? 'border-b border-gray py-3' : 'flex items-baseline justify-between gap-4 border-b border-gray py-2 last:border-0'}>
            <dt class={o.hero ? 'text-sm text-navy-600' : 'text-sm'}>{o.label}</dt>
            <dd
              data-calc-out={o.name}
              class={o.hero ? 'text-3xl font-semibold text-brand-800 tabular-nums' : 'text-base font-semibold tabular-nums'}
            >
              <span class="text-navy-600">Enable JavaScript to calculate</span>
            </dd>
            {o.hint && <p class="mt-1 text-xs text-navy-600">{o.hint}</p>}
          </div>
        ))}
      </dl>
      {note && <p class="mt-4 text-xs text-navy-600">{note}</p>}
    </div>
  </div>
</section>
