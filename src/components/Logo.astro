---
/** Text-based placeholder wordmark. Replace with the official SVG from the rlpmg-design skill in Phase 7. */
const { class: cls = '' } = Astro.props;
---

<svg class={cls} viewBox="0 0 260 40" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="logo-title">
  <title id="logo-title">RL Property Management</title>
  <rect x="0" y="2" width="36" height="36" fill="#59070e" />
  <text x="18" y="28" text-anchor="middle" font-family="Jost Variable, Jost, sans-serif" font-weight="700" font-size="20" fill="#fff">RL</text>
  <text x="46" y="27" font-family="Jost Variable, Jost, sans-serif" font-weight="600" font-size="19" fill="#123143" letter-spacing="0.2">Property Management</text>
</svg>
