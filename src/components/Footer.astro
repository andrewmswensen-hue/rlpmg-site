---
import { company } from '../data/facts';
import { monthYear } from '../lib/format';
import { LAST_VERIFIED } from '../data/facts';

const cols = [
  {
    heading: 'For owners',
    links: [
      ['/pricing/', 'Pricing'],
      ['/how-it-works/', 'How it works'],
      ['/columbus-property-management/', 'Services'],
      ['/what-we-manage/', 'What we manage'],
      ['/compare/', 'Compare'],
      ['/key-performance-indicators/', 'KPI scorecard'],
      ['/free-rent-evaluation/', 'Free rent evaluation'],
      ['/property-management-consultation/', 'Schedule a consultation'],
      ['/tools/', 'Calculators'],
      ['/agent-referrals/', 'Agent referrals'],
    ],
  },
  {
    heading: 'For residents',
    links: [
      ['/homes-for-rent/', 'Available rentals'],
      ['/residents/', 'Resident resources'],
      [company.portals.apply, 'Apply online'],
      [company.portals.resident, 'Pay rent'],
      [company.portals.maintenanceRequest, 'Maintenance request'],
      ['/resident-faqs/', 'Resident FAQ'],
    ],
  },
  {
    heading: 'Company',
    links: [
      ['/about/', 'About'],
      ['/team/', 'Team'],
      ['/reviews/', 'Reviews'],
      ['/areas-we-serve/', 'Areas we serve'],
      ['/blog/', 'Blog'],
      ['/guides/', 'Neighborhood guides'],
      ['/policy-updates/', 'Policy updates'],
      ['/faq/', 'FAQ'],
      ['/careers/', 'Careers'],
      ['/contact-us/', 'Contact'],
      ['/ai-and-human-oversight/', 'AI and human oversight'],
    ],
  },
];
---

<footer class="mt-24 bg-navy-800 text-navy-100">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl font-semibold text-white">{company.name}</p>
      <address class="mt-4 not-italic leading-relaxed">
        {company.legalName}<br />
        {company.address.streetLine1}, {company.address.streetLine2}<br />
        {company.address.city}, {company.address.region} {company.address.postalCode}<br />
        <a href={`tel:${company.contact.general.phoneE164}`} class="underline underline-offset-2">{company.contact.general.phone}</a>
        <span aria-hidden="true"> · </span>
        <a href={`mailto:${company.contact.general.email}`} class="underline underline-offset-2">{company.contact.general.email}</a>
      </address>
      <p class="mt-4 text-sm">
        Licensed Ohio real estate brokerage, {company.license.label} {company.license.number}. {company.brokerOfRecord.name}, {company.brokerOfRecord.title}. {company.hours.summary}
      </p>
      <p class="mt-4 text-sm">
        {company.reviews.ratingValue} out of 5 on Google across {company.reviews.reviewCount.toLocaleString('en-US')} reviews, as of {monthYear(company.reviews.asOf)}.
      </p>
      <ul class="mt-4 flex gap-4 text-sm">
        <li><a href={company.social.google} rel="noopener">Google</a></li>
        <li><a href={company.social.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={company.social.facebook} rel="noopener">Facebook</a></li>
        <li><a href={company.social.instagram} rel="noopener">Instagram</a></li>
        <li><a href={company.social.youtube} rel="noopener">YouTube</a></li>
      </ul>
    </div>
    {
      cols.map((c) => (
        <nav aria-label={c.heading}>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-white">{c.heading}</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {c.links.map(([href, label]) => (
              <li>
                <a href={href} class="hover:text-white hover:underline">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-navy-700">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-6 text-xs text-navy-200 md:flex-row md:items-center md:justify-between">
      <p>
        © {new Date().getFullYear()} {company.legalName}. Equal Housing Opportunity. NARPM member. Information on this site verified as of {monthYear(LAST_VERIFIED)}.
      </p>
      <ul class="flex flex-wrap gap-4">
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="/sms-consent/">SMS consent</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
    <p class="mx-auto max-w-7xl px-5 pb-6 text-xs text-navy-300">
      Some content on this site is drafted with AI assistance and reviewed by licensed RL Property Management staff before publication. Nothing here is legal, tax, or investment advice. Pricing is governed by the signed Property Management Agreement.
    </p>
  </div>
</footer>
