---
/**
 * The extraction contract, as a component. Renders: H1, byline, direct answer, key facts, the page body (slot),
 * FAQ (with FAQPage schema supplied by the page), "Last verified" line, related pages.
 * Everything here is plain server-rendered HTML. No JS.
 */
import { company } from '../data/facts';
import { monthYear } from '../lib/format';

interface Props {
  title: string;
  directAnswer: string;
  keyFacts: string[];
  faq?: { q: string; a: string }[];
  related?: { href: string; label: string }[];
  lastVerified: string | Date;
  reviewedBy?: string;
  eyebrow?: string;
  breadcrumbs?: { name: string; path: string }[];
}
const { title, directAnswer, keyFacts, faq = [], related = [], lastVerified, reviewedBy, eyebrow, breadcrumbs = [] } =
  Astro.props;
const verified = monthYear(typeof lastVerified === 'string' ? lastVerified : lastVerified.toISOString().slice(0, 10));
const reviewer = reviewedBy ?? `${company.brokerOfRecord.name}, ${company.brokerOfRecord.title}`;
---

<article class="mx-auto max-w-7xl px-5 py-12 md:py-16">
  {
    breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-navy-600">
        <ol class="flex flex-wrap gap-2">
          {breadcrumbs.map((b, i) => (
            <li>
              {i > 0 && <span aria-hidden="true" class="mr-2">/</span>}
              {i === breadcrumbs.length - 1 ? <span aria-current="page">{b.name}</span> : <a href={b.path} class="underline underline-offset-2">{b.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <header class="grid gap-8 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] md:gap-14">
    <div>
      {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent-600">{eyebrow}</p>}
      <h1 class="text-4xl md:text-5xl">{title}</h1>
      <p class="mt-4 text-sm text-navy-600">
        Reviewed by {reviewer}. Ohio brokerage {company.license.number}. Last reviewed {verified}.
      </p>
      <p class="direct-answer mt-6 text-lg leading-relaxed md:text-xl">{directAnswer}</p>
    </div>
    <aside aria-labelledby="key-facts" class="border-t-4 border-brand-800 bg-offwhite p-6 md:mt-2">
      <h2 id="key-facts" class="text-sm font-semibold uppercase tracking-wider text-navy-800">Key facts</h2>
      <ul class="mt-3 space-y-3 text-[0.95rem] leading-snug">
        {keyFacts.map((f) => <li class="border-b border-gray pb-3 last:border-0 last:pb-0">{f}</li>)}
      </ul>
    </aside>
  </header>

  <div class="prose-aeo mt-12">
    <slot />
  </div>

  {
    faq.length > 0 && (
      <section aria-labelledby="faq-heading" class="prose-aeo mt-14">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl>
          {faq.map((f) => (
            <div class="border-b border-gray py-4">
              <dt class="font-semibold text-navy-800">{f.q}</dt>
              <dd class="mt-1">{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <p class="mt-10 text-sm text-navy-600">Information on this page verified as of {verified}.</p>

  {
    related.length > 0 && (
      <nav aria-labelledby="related-heading" class="mt-10 border-t border-gray pt-6">
        <h2 id="related-heading" class="text-sm font-semibold uppercase tracking-wider text-navy-800">Related pages</h2>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem]">
          {related.map((r) => (
            <li>
              <a href={r.href} class="text-brand-800 underline underline-offset-3 hover:text-accent-600">
                {r.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</article>
