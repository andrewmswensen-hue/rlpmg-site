---
/**
 * The extraction contract, wearing the house style.
 *
 * Layout follows the 2026 Market Report kit: a dark hero carrying the eyebrow, H1, byline and the
 * direct answer, with the key facts as a navy panel; then the body on white with crimson-ruled H2s;
 * then FAQ, verified line, and related pages.
 *
 * Every fact still exists as plain text in the server-rendered HTML. Strip the CSS and this is a
 * complete, ordered answer document.
 */
import { company } from '../data/facts';
import { monthYear } from '../lib/format';

interface Props {
  title: string;
  directAnswer: string;
  keyFacts: string[];
  faq?: { q: string; a: string }[];
  related?: { href: string; label: string }[];
  lastVerified: string | Date;
  reviewedBy?: string;
  eyebrow?: string;
  breadcrumbs?: { name: string; path: string }[];
  /** Optional metric strip under the direct answer: big numbers, the kit's signature move. */
  metrics?: { value: string; label: string; caption?: string }[];
  /** Background image URL for the hero. Falls back to the flat navy-to-maroon gradient. */
  heroImage?: string;
  /** Wider body for pages that are mostly tables. */
  wide?: boolean;
}
const {
  title,
  directAnswer,
  keyFacts,
  faq = [],
  related = [],
  lastVerified,
  reviewedBy,
  eyebrow,
  breadcrumbs = [],
  metrics = [],
  heroImage,
  wide = false,
} = Astro.props;

const verified = monthYear(typeof lastVerified === 'string' ? lastVerified : lastVerified.toISOString().slice(0, 10));
const reviewer = reviewedBy ?? `${company.brokerOfRecord.name}, ${company.brokerOfRecord.title}`;
---

<header class:list={['rl-hero', heroImage && 'rl-hero-photo']} style={heroImage ? `--hero-img: url('${heroImage}')` : undefined}>
  {heroImage && <style is:inline set:html={`.rl-hero-photo::before{background-image:${`url('${heroImage}')`}}`} />}
  <div class="rl-container">
    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="rl-crumbs mb-6" data-md-skip>
          <ol class="flex flex-wrap gap-2">
            {breadcrumbs.map((b, i) => (
              <li>
                {i > 0 && <span aria-hidden="true" class="mr-2">/</span>}
                {i === breadcrumbs.length - 1 ? <span aria-current="page">{b.name}</span> : <a href={b.path}>{b.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {eyebrow && <p class="rl-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <span class="rl-rule light" aria-hidden="true"></span>
    <p class="direct-answer rl-lede">{directAnswer}</p>
    <p class="rl-byline mt-5">
      Reviewed by {reviewer}. Ohio brokerage {company.license.number}. Last reviewed {verified}.
    </p>

    {
      metrics.length > 0 && (
        <div class="rl-metrics">
          {metrics.map((m) => (
            <div class="rl-metric">
              <div class="value">{m.value}</div>
              <div class="label">{m.label}</div>
              {m.caption && <div class="caption">{m.caption}</div>}
            </div>
          ))}
        </div>
      )
    }
  </div>
</header>

<section class="rl-section alt" aria-labelledby="key-facts" style="padding-block: clamp(28px, 4vw, 44px)">
  <div class="rl-container">
    <dl class="rl-glance">
      <p class="rl-glance-title" id="key-facts">Key facts</p>
      {keyFacts.map((f) => (
        <div class="rl-glance-cell" style="grid-column: span 1">
          <dd class="text-[0.95rem] leading-snug text-white/95">{f}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<article class="rl-section">
  <div class="rl-container">
    <div class:list={['prose-aeo', wide && 'max-w-none']}>
      <slot />
    </div>

    {
      faq.length > 0 && (
        <section aria-labelledby="faq-heading" class="prose-aeo mt-14">
          <h2 id="faq-heading">Frequently asked questions</h2>
          <dl class="mt-6">
            {faq.map((f) => (
              <div class="rl-faq">
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <p class="rl-verified">Information on this page verified as of {verified}.</p>

    {
      related.length > 0 && (
        <nav aria-labelledby="related-heading" class="mt-10">
          <p id="related-heading" class="rl-eyebrow">Related pages</p>
          <ul class="flex flex-wrap gap-x-7 gap-y-2 text-[0.95rem]">
            {related.map((r) => (
              <li>
                <a href={r.href} class="underline underline-offset-4">{r.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</article>
