---
/**
 * Migrated from WordPress. This page carries its own scoped CSS (Andrew's long-form kit), so the styles
 * travel with the markup rather than using the site's Tailwind components.
 * Regenerate with: python3 scripts/import-longform.py
 */
import Base from '../../layouts/Base.astro';
import AeoPage from '../../components/AeoPage.astro';
import { LAST_VERIFIED } from '../../data/facts';
import { webPageNode, breadcrumbNode } from '../../lib/schema';

const path = "/client-handbook/";
const title = "Client Handbook | RL Property Management";
const description = "The client handbook for RL Property Management owners in Columbus, Ohio: rent disbursement, maintenance reserves, leasing, evictions, fair housing standards, fees, and contacts.";
const directAnswer = "The RL Property Management client handbook is the operating reference for property owners under management in Columbus, Ohio. It covers when rent is disbursed, how the maintenance reserve works, what happens during vacancy and leasing, how repairs are authorized and billed, lease renewals and rent increases, fair housing and screening standards, the full fee schedule, and who to contact for each type of question.";
const keyFacts = [
  "The handbook is the operating reference for current RL Property Management clients in Columbus, Ohio.",
  "It covers rent disbursement timing, maintenance reserves, leasing, evictions, renewals, and the full fee schedule.",
  "Fair housing standards cover federal, Ohio (military status), and Columbus (sexual orientation, gender identity, source of income) protected classes.",
  "Terms in the signed Property Management Agreement control where the handbook and the agreement differ."
];
const crumbs = [{ name: 'Home', path: '/' }, { name: "RL Property Management client handbook", path }];
const schema = [webPageNode({ path, title, description }), breadcrumbNode(crumbs)];
// The page's own scoped CSS, migrated with the markup. is:inline keeps Tailwind's parser out of it
// (the original stylesheet contains text Tailwind reads as a malformed at-rule).
const migratedCss = " tag through the\n  final </div>) into a single Divi Code Module on a new page.\n\n  ALL CSS is scoped under `.rl-handbook` so it can't collide\n  with your Divi styles. Font: Open Sans (inherited from rlpmg.com).\n  All colors are hardcoded hex (no var()) so WordPress won't\n  strip them on paste.\n\n  PLACEHOLDERS TO REPLACE BEFORE PUBLISHING:\n  - PDF download link (search \"REPLACE-PDF-URL\")\n  - Any image marked \"REPLACE-IMAGE\" if you want different photos\n  - Confirm the flagged text items (see Andrew's notes / CLAUDE.md)\n  ============================================================\n-->\n\n<style>\n/* ============================================================\n   Scope: everything under .rl-handbook so Divi can't leak in.\n   ============================================================ */\n.rl-handbook {\n  font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  color: #1a1a1a;\n  line-height: 1.55;\n  font-size: 17px;\n  background: #ffffff;\n  box-sizing: border-box;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n.rl-handbook *,\n.rl-handbook *::before,\n.rl-handbook *::after { box-sizing: border-box; }\n\n.rl-handbook h1,\n.rl-handbook h2,\n.rl-handbook h3,\n.rl-handbook h4,\n.rl-handbook h5,\n.rl-handbook h6 {\n  font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  color: #123143;\n  line-height: 1.15;\n  margin: 0 0 12px 0;\n  font-weight: 800;\n  letter-spacing: -0.005em;\n  text-transform: none;\n}\n.rl-handbook p {\n  margin: 0 0 16px 0;\n  max-width: 68ch;\n  color: #1a1a1a;\n}\n.rl-handbook a {\n  color: #a60530;\n  text-decoration: underline;\n  text-decoration-thickness: 1px;\n  text-underline-offset: 3px;\n}\n.rl-handbook a:hover { color: #59070e; }\n.rl-handbook ul,\n.rl-handbook ol { margin: 0 0 16px 0; padding-left: 22px; }\n.rl-handbook li { margin-bottom: 8px; }\n.rl-handbook strong,\n.rl-handbook b { font-weight: 700; color: inherit; }\n\n/* ============================================================\n   Layout shell\n   ============================================================ */\n.rl-handbook .rl-container {\n  max-width: 1120px;\n  margin: 0 auto;\n  padding-left: clamp(20px, 5vw, 64px);\n  padding-right: clamp(20px, 5vw, 64px);\n  width: 100%;\n}\n.rl-handbook .rl-section {\n  padding-top: clamp(36px, 5vw, 60px);\n  padding-bottom: clamp(36px, 5vw, 60px);\n  border-bottom: 1px solid #dddddd;\n}\n.rl-handbook .rl-section:last-of-type { border-bottom: 0; }\n/* Cream backgrounds removed in favor of the thin gray divider line above. */\n.rl-handbook .rl-section.alt { background: transparent; }\n\n/* Faded image band: white text on a darkened photo with the brand overlay */\n.rl-handbook .rl-section.imgband {\n  position: relative;\n  overflow: hidden;\n  background: #123143;\n  color: #ffffff;\n  border-bottom: 0;\n  padding-left: clamp(24px, 4vw, 44px);\n  padding-right: clamp(24px, 4vw, 44px);\n}\n.rl-handbook .rl-section.imgband::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image: url('https://rlpmg.com/wp-content/uploads/2026/04/autumn-street.jpg'); /* REPLACE-IMAGE (section bands) */\n  background-size: cover;\n  background-position: center;\n  filter: saturate(0.85) brightness(0.65);\n  z-index: 0;\n}\n.rl-handbook .rl-section.imgband::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(18,49,67,0.88) 0%, rgba(89,7,14,0.88) 100%);\n  z-index: 1;\n}\n.rl-handbook .rl-section.imgband > * { position: relative; z-index: 2; }\n.rl-handbook .rl-section.imgband h2,\n.rl-handbook .rl-section.imgband h3,\n.rl-handbook .rl-section.imgband p,\n.rl-handbook .rl-section.imgband li,\n.rl-handbook .rl-section.imgband strong,\n.rl-handbook .rl-section.imgband b { color: #ffffff; }\n.rl-handbook .rl-section.imgband .rl-eyebrow { color: #f5dde3; }\n.rl-handbook .rl-section.imgband .rl-rule { background: #ffffff; }\n.rl-handbook .rl-section.imgband a { color: #ffffff; text-decoration-color: rgba(255,255,255,0.6); }\n/* Protect the white address card so it stays dark-on-light inside a band */\n.rl-handbook .rl-section.imgband .rl-address,\n.rl-handbook .rl-section.imgband .rl-address strong,\n.rl-handbook .rl-section.imgband .rl-address b { color: #1a1a1a; }\n.rl-handbook .rl-section.imgband .rl-address b { color: #123143; }\n.rl-handbook .rl-section.imgband .rl-address a { color: #a60530; }\n\n/* Eyebrow + brand rule */\n.rl-handbook .rl-eyebrow {\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: #a60530;\n  margin-bottom: 10px;\n}\n.rl-handbook .rl-rule {\n  display: block;\n  width: 56px;\n  height: 3px;\n  background: #a60530;\n  margin: 14px 0 24px 0;\n}\n.rl-handbook .rl-h2 { font-size: clamp(28px, 4vw, 40px); }\n.rl-handbook .rl-lead { font-size: clamp(17px, 1.9vw, 20px); color: #123143; font-weight: 600; }\n\n/* ============================================================\n   HERO\n   ============================================================ */\n.rl-handbook .rl-hero {\n  position: relative;\n  min-height: 82vh;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  padding: 48px 0 56px;\n  background: #123143;\n  overflow: hidden;\n  color: #ffffff;\n}\n.rl-handbook .rl-hero::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image: url('https://rlpmg.com/wp-content/uploads/2026/04/hero-row-homes-scaled.jpg'); /* REPLACE-IMAGE (hero) */\n  background-size: cover;\n  background-position: center;\n  filter: saturate(0.85) brightness(0.6);\n  z-index: 0;\n}\n.rl-handbook .rl-hero::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(18,49,67,0.5) 0%, rgba(89,7,14,0.7) 55%, rgba(89,7,14,0.92) 100%);\n  z-index: 1;\n}\n.rl-handbook .rl-hero .rl-container { position: relative; z-index: 2; }\n.rl-handbook .rl-hero-top {\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  z-index: 2;\n  padding: 28px 0;\n}\n.rl-handbook .rl-hero-top .rl-container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.rl-handbook .rl-hero-label {\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: 0.26em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.95);\n}\n.rl-handbook .rl-hero-title-rule { width: 64px; height: 4px; background: #ffffff; margin-bottom: 22px; }\n.rl-handbook .rl-hero-kicker {\n  font-weight: 700;\n  font-size: 13px;\n  letter-spacing: 0.26em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.95);\n  margin-bottom: 18px;\n}\n.rl-handbook .rl-hero h1 {\n  font-weight: 800;\n  font-size: clamp(40px, 7vw, 78px);\n  line-height: 1.0;\n  color: #ffffff;\n  letter-spacing: -0.02em;\n  margin: 0 0 20px 0;\n  max-width: 16ch;\n}\n.rl-handbook .rl-hero-year {\n  font-weight: 800;\n  font-size: clamp(48px, 8vw, 82px);\n  line-height: 0.9;\n  color: #a60530;\n  letter-spacing: -0.03em;\n  display: block;\n  margin: 0 0 24px 0;\n}\n.rl-handbook .rl-hero-subtitle {\n  font-size: clamp(16px, 1.7vw, 20px);\n  line-height: 1.5;\n  max-width: 600px;\n  color: rgba(255,255,255,0.95);\n  margin: 0;\n  font-weight: 600;\n}\n.rl-handbook .rl-hero-metrics {\n  margin-top: 44px;\n  padding-top: 28px;\n  border-top: 3px solid #a60530;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n}\n.rl-handbook .rl-hero-metric .value {\n  font-weight: 800;\n  font-size: clamp(28px, 4vw, 42px);\n  color: #ffffff;\n  line-height: 1;\n  letter-spacing: -0.02em;\n}\n.rl-handbook .rl-hero-metric .label {\n  font-weight: 700;\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  margin-top: 10px;\n  color: rgba(255,255,255,0.95);\n}\n.rl-handbook .rl-hero-metric .caption { font-size: 12px; margin-top: 4px; color: rgba(255,255,255,0.7); }\n\n/* Download band */\n.rl-handbook .rl-dl-band {\n  background: #f7f5f3;\n  padding: 30px 24px;\n  text-align: center;\n  border-bottom: 1px solid #dddddd;\n}\n.rl-handbook .rl-dl-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  background: #a60530;\n  color: #ffffff !important;\n  padding: 14px 30px;\n  font-weight: 800;\n  font-size: 13px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  border: 2px solid #a60530;\n  transition: all 160ms;\n}\n.rl-handbook .rl-dl-btn:hover { background: #59070e; border-color: #59070e; color: #ffffff !important; }\n.rl-handbook .rl-dl-sub { font-size: 13px; color: #555555; margin-top: 12px; }\n\n/* ============================================================\n   Body with sticky TOC\n   ============================================================ */\n.rl-handbook .rl-toc-wrap {\n  display: grid;\n  grid-template-columns: 230px minmax(0, 1fr);\n  gap: 56px;\n  max-width: 1120px;\n  margin: 0 auto;\n  padding-left: clamp(20px, 5vw, 64px);\n  padding-right: clamp(20px, 5vw, 64px);\n}\n.rl-handbook .rl-toc {\n  position: sticky;\n  top: 24px;\n  align-self: start;\n  font-size: 13px;\n  padding: 24px 20px 24px 0;\n  max-height: 100vh;\n  overflow-y: auto;\n  border-right: 1px solid #dddddd;\n}\n.rl-handbook .rl-toc-title {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: #a60530;\n  margin-bottom: 16px;\n}\n.rl-handbook .rl-toc ol { list-style: none; padding: 0; margin: 0; counter-reset: rltoc; }\n.rl-handbook .rl-toc li {\n  margin: 0 0 10px 0;\n  counter-increment: rltoc;\n  display: flex;\n  gap: 10px;\n}\n.rl-handbook .rl-toc li::before {\n  content: counter(rltoc, decimal-leading-zero);\n  color: #a60530;\n  font-weight: 700;\n  font-size: 11px;\n}\n.rl-handbook .rl-toc a { color: #123143; text-decoration: none; font-weight: 600; line-height: 1.3; }\n.rl-handbook .rl-toc a:hover { color: #a60530; }\n\n/* Quick-facts glance grid */\n.rl-handbook .rl-glance {\n  margin-top: 28px;\n  background: #123143;\n  color: #ffffff;\n  padding: 32px;\n  border-top: 3px solid #a60530;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px 36px;\n}\n.rl-handbook .rl-glance-title {\n  grid-column: 1 / -1;\n  font-weight: 800;\n  font-size: 14px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding-bottom: 14px;\n  border-bottom: 1px solid rgba(255,255,255,0.2);\n  margin: 0;\n  color: #ffffff;\n}\n.rl-handbook .rl-glance-cell .value { font-weight: 800; font-size: 26px; color: #f5dde3; line-height: 1.05; letter-spacing: -0.01em; }\n.rl-handbook .rl-glance-cell .label { font-weight: 700; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; margin-top: 10px; color: #ffffff; }\n.rl-handbook .rl-glance-cell .caption { font-size: 12px; margin-top: 4px; color: rgba(255,255,255,0.78); }\n\n/* Split layout */\n.rl-handbook .rl-split {\n  display: grid;\n  grid-template-columns: 1.1fr 1fr;\n  gap: 40px;\n  margin: 28px 0;\n  align-items: start;\n}\n.rl-handbook .rl-split-img {\n  position: relative;\n  overflow: hidden;\n  aspect-ratio: 4 / 3;\n  background: #dddddd;\n  border: 1px solid #dddddd;\n}\n.rl-handbook .rl-split-img img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.rl-handbook .rl-split-img .tag {\n  position: absolute;\n  bottom: 0; left: 0;\n  background: #59070e;\n  color: #ffffff;\n  font-weight: 700;\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  padding: 8px 14px;\n  text-transform: uppercase;\n}\n\n/* Pullquote + dark quote */\n.rl-handbook .rl-pullquote {\n  font-weight: 700;\n  font-style: italic;\n  font-size: clamp(19px, 2.2vw, 26px);\n  line-height: 1.3;\n  color: #59070e;\n  text-align: center;\n  padding: 32px 24px;\n  margin: 36px 0;\n  border-top: 2px solid #dddddd;\n  border-bottom: 2px solid #dddddd;\n  max-width: none;\n}\n.rl-handbook .rl-dark-quote {\n  background: #59070e;\n  color: #ffffff;\n  padding: 32px 36px;\n  margin: 36px 0;\n  font-weight: 600;\n  font-style: italic;\n  font-size: clamp(18px, 2vw, 22px);\n  line-height: 1.35;\n  text-align: center;\n  border-left: 4px solid #a60530;\n}\n\n/* Callout box */\n.rl-handbook .rl-callout {\n  background: #f7f5f3;\n  border-left: 3px solid #a60530;\n  padding: 16px 20px;\n  font-size: 15px;\n  color: #444444;\n  margin: 22px 0;\n  line-height: 1.6;\n}\n.rl-handbook .rl-callout b { color: #123143; }\n.rl-handbook .rl-callout.navy { border-left-color: #123143; }\n\n/* Tables */\n.rl-handbook .rl-table-wrap { overflow-x: auto; margin: 24px 0; }\n.rl-handbook table.rl-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 14.5px;\n  min-width: 560px;\n}\n.rl-handbook table.rl-table thead th {\n  background: #123143;\n  color: #ffffff;\n  padding: 12px 16px;\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  text-align: left;\n  border-right: 1px solid rgba(255,255,255,0.15);\n}\n.rl-handbook table.rl-table thead th:last-child { border-right: 0; }\n.rl-handbook table.rl-table tbody td {\n  padding: 12px 16px;\n  border-bottom: 1px solid #dddddd;\n  vertical-align: top;\n  line-height: 1.5;\n}\n.rl-handbook table.rl-table tbody tr:nth-child(even) td { background: #f7f5f3; }\n.rl-handbook table.rl-table td.num { font-weight: 800; color: #59070e; white-space: nowrap; }\n.rl-handbook table.rl-table td.label { font-weight: 700; color: #123143; }\n.rl-handbook table.rl-fees thead th { background: #59070e; }\n\n/* Numbered process checklist */\n.rl-handbook .rl-checklist { border: 1px solid #dddddd; background: #f7f5f3; margin: 18px 0; }\n.rl-handbook .rl-checklist-row {\n  display: flex;\n  align-items: flex-start;\n  gap: 14px;\n  padding: 13px 18px;\n  border-bottom: 1px solid #dddddd;\n  font-size: 15px;\n  line-height: 1.5;\n}\n.rl-handbook .rl-checklist-row:last-child { border-bottom: 0; }\n.rl-handbook .rl-checklist-row:nth-child(even) { background: #ffffff; }\n.rl-handbook .rl-checkbox {\n  flex-shrink: 0;\n  width: 18px; height: 18px;\n  border: 1.5px solid #123143;\n  background: #ffffff;\n  border-radius: 2px;\n  margin-top: 2px;\n}\n.rl-handbook .rl-stepnum {\n  flex-shrink: 0;\n  width: 24px; height: 24px;\n  background: #59070e;\n  color: #ffffff;\n  border-radius: 50%;\n  font-weight: 800;\n  font-size: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 1px;\n}\n\n/* Contact / info cards */\n.rl-handbook .rl-emp-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 16px;\n  margin: 22px 0;\n}\n.rl-handbook .rl-emp-card { background: #f7f5f3; border-left: 3px solid #123143; padding: 16px 20px; }\n.rl-handbook .rl-emp-card h5 {\n  font-size: 12px;\n  color: #59070e;\n  margin: 0 0 6px 0;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  font-weight: 800;\n}\n.rl-handbook .rl-emp-card .role { font-style: italic; color: #123143; font-weight: 600; font-size: 14px; margin: 0 0 6px 0; }\n.rl-handbook .rl-emp-card p { font-size: 14px; margin: 0; color: #222222; line-height: 1.55; }\n\n/* Numbered value cards */\n.rl-handbook .rl-value {\n  border: 1px solid #dddddd;\n  background: #ffffff;\n  display: grid;\n  grid-template-columns: 72px 1fr;\n  margin: 14px 0;\n}\n.rl-handbook .rl-value .num {\n  background: #123143;\n  color: #ffffff;\n  font-weight: 800;\n  font-size: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.rl-handbook .rl-value .body { padding: 18px 24px; }\n.rl-handbook .rl-value .body h4 { font-size: 20px; color: #123143; margin: 0 0 6px 0; font-weight: 800; }\n.rl-handbook .rl-value .body p { margin: 0; font-size: 15px; line-height: 1.55; }\n\n/* FAQ accordion */\n.rl-handbook .rl-faq { border-top: 1px solid #dddddd; padding: 18px 0; }\n.rl-handbook .rl-faq summary {\n  font-weight: 800;\n  font-size: 17px;\n  color: #123143;\n  cursor: pointer;\n  list-style: none;\n  padding-right: 32px;\n  position: relative;\n  line-height: 1.35;\n}\n.rl-handbook .rl-faq summary::-webkit-details-marker { display: none; }\n.rl-handbook .rl-faq summary::after {\n  content: '+';\n  position: absolute;\n  right: 0; top: 0;\n  width: 24px; height: 24px;\n  color: #a60530;\n  font-size: 24px;\n  font-weight: 400;\n  line-height: 1;\n}\n.rl-handbook .rl-faq[open] summary::after { content: '\\2212'; }\n.rl-handbook .rl-faq p { margin: 10px 0 0 0; font-size: 15px; line-height: 1.6; }\n\n/* Address block */\n.rl-handbook .rl-address {\n  background: #ffffff;\n  border: 1px solid #dddddd;\n  border-left: 3px solid #a60530;\n  padding: 16px 20px;\n  font-size: 15px;\n  line-height: 1.6;\n  margin: 20px 0;\n  max-width: 420px;\n}\n.rl-handbook .rl-address b { color: #123143; }\n\n/* CTA */\n.rl-handbook .rl-cta-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  background: #123143;\n  color: #ffffff;\n  margin-top: 24px;\n}\n.rl-handbook .rl-cta-grid .box { padding: 28px 32px; border-right: 1px solid rgba(255,255,255,0.2); }\n.rl-handbook .rl-cta-grid .box:last-child { border-right: 0; }\n.rl-handbook .rl-cta-grid h3 { color: #ffffff; font-size: 20px; margin: 0 0 10px 0; font-weight: 800; }\n.rl-handbook .rl-cta-grid p { color: rgba(255,255,255,0.9); font-size: 14px; margin-bottom: 18px; max-width: none; }\n.rl-handbook .rl-cta-btn {\n  display: inline-block;\n  background: #ffffff;\n  color: #59070e !important;\n  padding: 12px 24px;\n  font-weight: 800;\n  font-size: 12px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  border: 2px solid #ffffff;\n  transition: background 160ms, color 160ms;\n}\n.rl-handbook .rl-cta-btn:hover { background: #a60530; color: #ffffff !important; border-color: #a60530; }\n.rl-handbook .rl-cta-contact {\n  margin-top: 22px;\n  padding-top: 18px;\n  border-top: 1px solid #dddddd;\n  font-weight: 700;\n  font-size: 15px;\n  color: #123143;\n  text-align: center;\n  line-height: 1.7;\n}\n.rl-handbook .rl-cta-contact .phone { color: #a60530; }\n\n.rl-handbook .rl-muted { color: #555555; font-size: 13px; }\n.rl-handbook .rl-small-note { font-size: 12.5px; color: #555555; line-height: 1.55; margin-top: 16px; }\n.rl-handbook .rl-about-logo { max-width: 260px; height: auto; margin: 8px 0 16px 0; }\n\n/* Responsive */\n@media (max-width: 960px) {\n  .rl-handbook .rl-toc-wrap { grid-template-columns: minmax(0, 1fr); gap: 0; }\n  .rl-handbook .rl-toc { display: none; }\n}\n@media (max-width: 720px) {\n  .rl-handbook { font-size: 16px; }\n  .rl-handbook .rl-hero { min-height: 72vh; padding-bottom: 40px; }\n  .rl-handbook .rl-hero-metrics { grid-template-columns: 1fr; gap: 16px; }\n  .rl-handbook .rl-glance { grid-template-columns: 1fr 1fr; padding: 22px; gap: 18px 20px; }\n  .rl-handbook .rl-glance-cell .value { font-size: 22px; }\n  .rl-handbook .rl-split { grid-template-columns: 1fr; gap: 20px; }\n  .rl-handbook .rl-emp-grid { grid-template-columns: 1fr; }\n  .rl-handbook .rl-cta-grid { grid-template-columns: 1fr; }\n  .rl-handbook .rl-cta-grid .box { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.2); }\n  .rl-handbook .rl-cta-grid .box:last-child { border-bottom: 0; }\n}\n@media (max-width: 480px) {\n  .rl-handbook .rl-glance { grid-template-columns: 1fr; }\n  .rl-handbook .rl-value { grid-template-columns: 56px 1fr; }\n  .rl-handbook .rl-value .num { font-size: 22px; }\n}\n";
---

<Base {title} {description} {path} {schema}>
  <AeoPage
    title="RL Property Management client handbook"
    {directAnswer}
    {keyFacts}
    lastVerified={LAST_VERIFIED}
    breadcrumbs={crumbs}
    related={[
      { href: '/pricing/', label: 'Pricing' },
      { href: '/faq/', label: 'Owner FAQ' },
      { href: '/key-performance-indicators/', label: 'KPI scorecard' },
