---
import Base from '../../../layouts/Base.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { company } from '../../../data/facts';
import { webPageNode, breadcrumbNode } from '../../../lib/schema';
const path = '/residents/leasing-form/';
const title = 'Leasing Inquiry | RL Property Management';
const description = 'Ask the RL Property Management leasing team about a listing, a showing, or an application for a Columbus, Ohio rental. Responses come by email or phone from the leasing team.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Residents', path: '/residents/' }, { name: 'Leasing inquiry', path }];
---

<Base {title} {description} {path} schema={[webPageNode({ path, title, description, reviewedBy: false }), breadcrumbNode(crumbs)]}>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-4xl">Leasing inquiry</h1>
    <p class="mt-4 text-lg">Ask about a specific listing, a showing time, or an application in progress. The leasing team responds by email or phone. For repairs, use the <a href={company.portals.maintenanceRequest} class="underline" rel="noopener">maintenance portal</a> instead.</p>
    <div class="mt-8">
      <LeadForm id="leasing-inquiry" fields={[
        { name: 'name', label: 'Full name', required: true, autocomplete: 'name' },
        { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
        { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
        { name: 'listing', label: 'Property address or listing you are asking about' },
        { name: 'move_date', label: 'Desired move-in date' },
        { name: 'message', label: 'Question', type: 'textarea', required: true },
      ]} submitLabel="Send to leasing" />
    </div>
  </article>
</Base>
