ht: 800;\n  letter-spacing: -0.005em;\n  text-transform: none;\n}\n.rl-report-2026 p {\n  margin: 0 0 16px 0;\n  max-width: 68ch;\n  color: #1a1a1a;\n}\n.rl-report-2026 a {\n  color: #a60530;\n  text-decoration: underline;\n  text-decoration-thickness: 1px;\n  text-underline-offset: 3px;\n}\n.rl-report-2026 a:hover { color: #59070e; }\n.rl-report-2026 ul,\n.rl-report-2026 ol {\n  margin: 0 0 16px 0;\n  padding-left: 22px;\n}\n.rl-report-2026 li {\n  margin-bottom: 6px;\n}\n.rl-report-2026 strong,\n.rl-report-2026 b { font-weight: 700; color: inherit; }\n\n/* ============================================================\n   Layout shell\n   ============================================================ */\n.rl-report-2026 .rl-container {\n  max-width: 1120px;\n  margin: 0 auto;\n  padding-left: clamp(20px, 5vw, 64px);\n  padding-right: clamp(20px, 5vw, 64px);\n  width: 100%;\n}\n.rl-report-2026 .rl-section {\n  padding-top: clamp(48px, 8vw, 96px);\n  padding-bottom: clamp(48px, 8vw, 96px);\n  border-bottom: 1px solid #dddddd;\n}\n.rl-report-2026 .rl-section:last-of-type { border-bottom: 0; }\n.rl-report-2026 .rl-section.alt { background: #f7f5f3; }\n\n/* ============================================================\n   Eyebrow + brand rule\n   ============================================================ */\n.rl-report-2026 .rl-eyebrow {\n  font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: #a60530;\n  margin-bottom: 10px;\n}\n.rl-report-2026 .rl-rule {\n  display: block;\n  width: 56px;\n  height: 3px;\n  background: #a60530;\n  margin: 14px 0 24px 0;\n}\n\n/* ============================================================\n   HERO\n   ============================================================ */\n.rl-report-2026 .rl-hero {\n  position: relative;\n  min-height: 86vh;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  padding: 48px 0 56px;\n  background: #123143;\n  overflow: hidden;\n  color: #ffffff;\n}\n.rl-report-2026 .rl-hero::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image: url('https://rlpmg.com/wp-content/uploads/2026/04/autumn-street.jpg');\n  background-size: cover;\n  background-position: center;\n  filter: saturate(0.85) brightness(0.65);\n  z-index: 0;\n}\n.rl-report-2026 .rl-hero::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(18,49,67,0.5) 0%, rgba(89,7,14,0.7) 55%, rgba(89,7,14,0.92) 100%);\n  z-index: 1;\n}\n.rl-report-2026 .rl-hero .rl-container {\n  position: relative;\n  z-index: 2;\n}\n.rl-report-2026 .rl-hero-top {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 2;\n  padding: 28px 0;\n}\n.rl-report-2026 .rl-hero-top .rl-container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.rl-report-2026 .rl-hero-label {\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: 0.26em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.95);\n}\n.rl-report-2026 .rl-hero-title-rule {\n  width: 64px;\n  height: 4px;\n  background: #ffffff;\n  margin-bottom: 22px;\n}\n.rl-report-2026 .rl-hero-kicker {\n  font-weight: 700;\n  font-size: 13px;\n  letter-spacing: 0.26em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.95);\n  margin-bottom: 20px;\n}\n.rl-report-2026 .rl-hero h1 {\n  font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  font-weight: 800;\n  font-size: clamp(38px, 6vw, 68px);\n  line-height: 1.03;\n  color: #ffffff;\n  letter-spacing: -0.015em;\n  margin: 0 0 18px 0;\n  max-width: 14ch;\n}\n.rl-report-2026 .rl-hero-year {\n  font-weight: 800;\n  font-size: clamp(72px, 12vw, 140px);\n  line-height: 0.9;\n  color: #a60530;\n  letter-spacing: -0.03em;\n  display: block;\n  margin: 4px 0 24px 0;\n}\n.rl-r