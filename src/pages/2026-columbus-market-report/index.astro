mp-card {\n  background: #f7f5f3;\n  border-left: 3px solid #123143;\n  padding: 14px 18px;\n}\n.rl-report-2026 .rl-emp-card h5 {\n  font-size: 12px;\n  color: #59070e;\n  margin: 0 0 4px 0;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  font-weight: 800;\n}\n.rl-report-2026 .rl-emp-card p {\n  font-size: 13px;\n  margin: 0;\n  color: #222222;\n  line-height: 1.45;\n}\n\n/* Source items */\n.rl-report-2026 .rl-source {\n  padding: 12px 0;\n  border-bottom: 1px solid #dddddd;\n  font-size: 14px;\n  line-height: 1.6;\n}\n.rl-report-2026 .rl-source:last-child { border-bottom: 0; }\n.rl-report-2026 .rl-source b { color: #123143; }\n\n/* About page-like block */\n.rl-report-2026 .rl-about-logo {\n  max-width: 280px;\n  height: auto;\n  margin: 18px 0 16px 0;\n}\n\n/* Small utility */\n.rl-report-2026 .rl-muted { color: #555555; font-size: 13px; }\n.rl-report-2026 .rl-small-disclaimer {\n  font-size: 12px;\n  color: #555555;\n  line-height: 1.55;\n  margin-top: 16px;\n}\n\n/* ============================================================\n   RESPONSIVE ,  mobile breakpoints\n   ============================================================ */\n@media (max-width: 960px) {\n  .rl-report-2026 .rl-toc-wrap { grid-template-columns: 1fr; gap: 0; }\n  .rl-report-2026 .rl-toc { display: none; }\n}\n@media (max-width: 720px) {\n  .rl-report-2026 { font-size: 16px; }\n  .rl-report-2026 .rl-hero { min-height: 72vh; padding-bottom: 40px; }\n  .rl-report-2026 .rl-hero-metrics {\n    grid-template-columns: 1fr;\n    gap: 16px;\n  }\n  .rl-report-2026 .rl-glance { grid-template-columns: 1fr 1fr; padding: 22px; gap: 18px 20px; }\n  .rl-report-2026 .rl-glance-cell .value { font-size: 24px; }\n  .rl-report-2026 .rl-split { grid-template-columns: 1fr; gap: 20px; }\n  .rl-report-2026 .rl-chart-grid2 { grid-template-columns: 1fr; }\n  .rl-report-2026 .rl-cta-grid { grid-template-columns: 1fr; }\n  .rl-report-2026 .rl-cta-grid .box { border-right: 0; border-bottom: 1px solid rgba(255,2