 height: auto;\n}\n.rl-report-2026 .rl-chart-grid2 {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n\n/* ============================================================\n   Metrics table\n   ============================================================ */\n.rl-report-2026 .rl-table-wrap { overflow-x: auto; margin: 24px 0; }\n.rl-report-2026 table.rl-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 14px;\n  min-width: 560px;\n}\n.rl-report-2026 table.rl-table thead th {\n  background: #123143;\n  color: #ffffff;\n  padding: 12px 16px;\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  text-align: left;\n  border-right: 1px solid rgba(255,255,255,0.15);\n}\n.rl-report-2026 table.rl-table thead th:last-child { border-right: 0; }\n.rl-report-2026 table.rl-table tbody td {\n  padding: 12px 16px;\n  border-bottom: 1px solid #dddddd;\n  vertical-align: top;\n}\n.rl-report-2026 table.rl-table tbody tr:nth-child(even) td { background: #f7f5f3; }\n.rl-report-2026 table.rl-table td.num {\n  font-weight: 800;\n  color: #59070e;\n}\n.rl-report-2026 table.rl-table td.label {\n  font-weight: 700;\n  color: #123143;\n}\n.rl-report-2026 table.rl-playbook thead th { background: #59070e; }\n.rl-report-2026 table.rl-playbook td.strategy { font-weight: 700; color: #123143; }\n\n/* ============================================================\n   Neighborhood cards\n   ============================================================ */\n.rl-report-2026 .rl-nbhd {\n  border: 1px solid #dddddd;\n  background: #ffffff;\n  display: grid;\n  grid-template-columns: 72px 1fr 160px;\n  margin: 14px 0;\n}\n.rl-report-2026 .rl-nbhd .num {\n  background: #59070e;\n  color: #ffffff;\n  font-weight: 800;\n  font-size: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.rl-report-2026 .rl-nbhd .body {\n  padding: 18px 22px;\n}\n.rl-report-2026 .rl-nbhd .body h4 {\n  font-size: 18px;\n  colo