t: 700;\n  font-size: 11px;\n}\n.rl-report-2026 .rl-toc a {\n  color: #123143;\n  text-decoration: none;\n  font-weight: 600;\n  line-height: 1.3;\n}\n.rl-report-2026 .rl-toc a:hover { color: #a60530; }\n\n/* ============================================================\n   At-a-glance grid\n   ============================================================ */\n.rl-report-2026 .rl-glance {\n  margin-top: 28px;\n  background: #123143;\n  color: #ffffff;\n  padding: 32px;\n  border-top: 3px solid #a60530;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px 36px;\n}\n.rl-report-2026 .rl-glance-title {\n  grid-column: 1 / -1;\n  font-weight: 800;\n  font-size: 14px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding-bottom: 14px;\n  border-bottom: 1px solid rgba(255,255,255,0.2);\n  margin: 0;\n  color: #ffffff;\n}\n.rl-report-2026 .rl-glance-cell .value {\n  font-weight: 800;\n  font-size: 30px;\n  color: #f5dde3;\n  line-height: 1;\n  letter-spacing: -0.02em;\n}\n.rl-report-2026 .rl-glance-cell .label {\n  font-weight: 700;\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  margin-top: 10px;\n  color: #ffffff;\n}\n.rl-report-2026 .rl-glance-cell .caption {\n  font-size: 12px;\n  margin-top: 4px;\n  color: rgba(255,255,255,0.78);\n}\n\n/* ============================================================\n   Two-column split layout\n   ============================================================ */\n.rl-report-2026 .rl-split {\n  display: grid;\n  grid-template-columns: 1.1fr 1fr;\n  gap: 40px;\n  margin: 28px 0;\n  align-items: start;\n}\n.rl-report-2026 .rl-split-img {\n  position: relative;\n  overflow: hidden;\n  aspect-ratio: 4 / 3;\n  background: #dddddd;\n  border: 1px solid #dddddd;\n}\n.rl-report-2026 .rl-split-img img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.rl-report-2026 .rl-split-img .tag {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  background: #59070e